        <accessory> <!-- Guncam needs to use Hub Internal slot -->
            <id>9a27efa9-f3f4-4e47-9165-76e8adbad4ba</id>
            <mount amendoperation="regexreplace" regexpattern="Internal">Hub Internal</mount>
        </accessory>
